TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENAI_API_KEY=sk-your-openai-key
WEBHOOK_SECRET=a-random-string-you-generate
VERCEL_URL=your-app.vercel.app
# Neon Postgres connection string — auto-injected by the Vercel/Neon integration on Vercel.
# For local dev, copy it from the Vercel project's Env Vars tab.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Cron-only secret. NOT accepted on the admin panel anymore.
CRON_SECRET=random-string-for-cron-auth
# Admin panel HTTP Basic Auth. Bearer-token form is `Authorization: Bearer $ADMIN_PASSWORD`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=another-random-string-you-generate
