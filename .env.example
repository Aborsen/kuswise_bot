TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENAI_API_KEY=sk-your-openai-key
WEBHOOK_SECRET=a-random-string-you-generate
VERCEL_URL=your-app.vercel.app
# Neon Postgres connection string — auto-injected by the Vercel/Neon integration on Vercel.
# For local dev, copy it from the Vercel project's Env Vars tab.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Cron-only secret. NOT accepted on the admin panel anymore.
CRON_SECRET=random-string-for-cron-auth

# --- Admin panel (api/admin_stats.py) ---
# HTTP Basic Auth. Bearer-token form is `Authorization: Bearer $ADMIN_PASSWORD`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=another-random-string-you-generate

# --- Observability (W0-1) ---
# Free Sentry account at https://sentry.io. Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting (W0-3) ---
# Per-user / per-day caps for OpenAI-billed actions. Tune from telemetry.
LIMIT_PHOTO_PER_DAY=50
LIMIT_ASK_PER_DAY=20
LIMIT_OCR_PER_DAY=5
LIMIT_PLAN_PER_DAY=3
LIMIT_TOTAL_AI_PER_DAY=100
# Hard ceiling on per-user OpenAI spend per day, USD. 0 disables the budget guard.
DAILY_OPENAI_USD_CAP=2.0
